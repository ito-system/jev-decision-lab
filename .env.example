# Jev Decision Lab の環境変数の例
# このファイルをコピーして .env.local を作り、TYPESAFE_API_KEY を設定する:
#   cp .env.example .env.local
# .env.local は .gitignore 済み。APIキーをコミットしないこと。

# TypeSafe AI の APIキー（https://console.typesafe.ai/keys で発行）
# サーバー側だけで使う。NEXT_PUBLIC_ を付けてはいけない（ブラウザに公開されてしまう）。
TYPESAFE_API_KEY=

# live: Jev API を呼ぶ / mock: 事前定義のサンプル値を返す（Jev API は呼ばない）
JEV_DEMO_MODE=live

# 任意: モデルのバージョンを固定する（未設定なら SDK 既定の jev-latest）
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# 任意: 公開 URL で動かすときの Basic 認証（BASIC_AUTH_PASSWORD を設定すると有効）
# BASIC_AUTH_USER=jev
# BASIC_AUTH_PASSWORD=
